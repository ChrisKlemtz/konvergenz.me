{
  "functions": {
    "api/*.php": { "runtime": "vercel-php@0.7.3" }
  },
  "routes": [
    { "src": "/(data|inc|lang|pages|api)(/.*)?", "dest": "/api/index.php" },
    { "src": "/.*\\.(php|md|json)", "dest": "/api/index.php" },
    { "src": "/\\..*", "dest": "/api/index.php" },
    { "src": "/admin/?", "dest": "/api/admin.php" },
    { "handle": "filesystem" },
    { "src": "/.*", "dest": "/api/index.php" }
  ]
}
